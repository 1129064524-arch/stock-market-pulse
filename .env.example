# Any OpenAI-compatible provider. Keep the key in .env; never expose it to the browser.
# This project also recognizes PROMPT_ANALYSIS_API_BASE_URL, PROMPT_ANALYSIS_ENDPOINT,
# PROMPT_ANALYSIS_API_KEY and PROMPT_ANALYSIS_MODEL from 图案优化系统's visual-analysis channel.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-4.1-mini
LLM_PROTOCOL=chat_completions
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=25
# Optional background coordination. The scheduler only calls the model during
# trading sessions and stores the latest bounded research output locally.
LLM_AUTO_ANALYSIS=false
LLM_AUTO_ANALYSIS_MINUTES=3

# Route every backend request to Eastmoney and the LLM provider through one
# proxy. Examples: http://127.0.0.1:7890 or http://user:pass@host:port
# OUTBOUND_PROXY=http://127.0.0.1:7890
# PROXY_URL is accepted as an alias. HTTPS_PROXY/HTTP_PROXY/ALL_PROXY are
# used as fallbacks when OUTBOUND_PROXY is not set. NO_PROXY is respected.

# Optional fund observation pool. Comma-separated six-digit fund codes.
# FUND_WATCHLIST=110022,003095,005827,161725

# The desktop build scans the full fund universe; this only changes the
# optional personal overlay in the Fund Full View.
# FUND_SCAN_LIMIT=30
